{
  "name": "spk-r5-parking-log",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run start:dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace api && npm run build --workspace web",
    "lint": "npm run lint --workspace api && npm run lint --workspace web",
    "db:generate": "npm run prisma:generate --workspace api",
    "db:push": "npm run prisma:push --workspace api",
    "db:seed": "npm run prisma:seed --workspace api"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
