# Frontend: default เรียก /api บน origin เดียวกัน (dev ใช้ Vite proxy ไป :3001)
# ตั้งเฉพาะเมื่อ API อยู่ที่ path อื่น
# VITE_API_URL=/api

# Backend
BACKEND_PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
JWT_ACCESS_SECRET=<replace-with-a-random-secret-of-at-least-32-bytes>
# ต้องไม่ซ้ำกับ JWT_ACCESS_SECRET ไม่งั้น backend ไม่ยอม start
AUTH_TOKEN_PEPPER=<replace-with-another-random-secret-of-at-least-32-bytes>
COOKIE_SECURE=false
# จำนวน reverse-proxy hop ที่เชื่อถือได้: local/direct = 0, proxy เดียว = 1
# production ต้องตั้งเอง และต้องตรงกับ proxy จริง เพราะ login lockout ล็อกแยกตาม IP
TRUST_PROXY_HOPS=0
ADMIN_USERNAME=<set-in-local-env>
ADMIN_PASSWORD=<set-a-strong-temporary-password>
ADMIN_DISPLAY_NAME=<set-admin-display-name>

# PostgreSQL
POSTGRES_DB=spk_r5_parking_log
POSTGRES_USER=spk_r5
POSTGRES_PASSWORD=spk_r5_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://spk_r5:spk_r5_local@localhost:5432/spk_r5_parking_log
