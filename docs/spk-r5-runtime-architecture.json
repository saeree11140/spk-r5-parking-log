  "cards": [
    {
      "dot": "cyan",
      "title": "Primary runtime path",
      "items": [
        "ADMIN / STAFF use a Web Locks-capable desktop browser; static Next.js export has no BFF, SSR, or API Routes",
        "TanStack Query and Zustand drive typed Axios requests directly to NEXT_PUBLIC_API_URL"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust & security",
      "items": [
        "NestJS :3001 exposes /api with validation, credentialed CORS, rate limiting, and global CSRF/auth/RBAC guards",
        "Mutations require exact Origin and double-submit X-CSRF-Token",
        "HttpOnly access/refresh cookies; every protected request rechecks active session and user in PostgreSQL"
      ]
    },
    {
      "dot": "emerald",
      "title": "Domain, data & scope",
      "items": [
        "Controllers and services own parking/user rules plus audit writes inside Serializable transactions; Prisma P2034 retries up to three times",
        "PrismaPg reaches PostgreSQL 18.4, the only active external data service",
        "Evidence storage, object storage, online payment, and production hosting remain out of scope"
      ]
    }
  ]
